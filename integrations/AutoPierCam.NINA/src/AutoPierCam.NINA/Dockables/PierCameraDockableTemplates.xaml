<ResourceDictionary
    x:Class="AutoPierCam.NINA.Dockables.PierCameraDockableTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="AutoPierCam.NINA.Dockables.PierCameraDockable_Dockable">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                MinHeight="220"
                Background="#FF10151D"
                BorderBrush="#406F819A"
                BorderThickness="1"
                CornerRadius="4"
                ClipToBounds="True">
                <Grid>
                    <Image
                        Margin="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Opacity="{Binding Preview.ImageOpacity}"
                        SnapsToDevicePixels="True"
                        Source="{Binding Preview.Image}"
                        Stretch="Uniform" />

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="430"
                        Margin="24">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Preview.HasImage}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#FFF2F5F8"
                            Text="Pier camera preview" />
                        <TextBlock
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Foreground="#FFB8C2CF"
                            Text="{Binding Preview.StatusText}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Border
                        Margin="10"
                        Padding="8,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="#D9202935"
                        CornerRadius="3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Preview.HasImage}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="#FFF2F5F8"
                            Text="{Binding Preview.ConnectionText}" />
                    </Border>

                    <Border
                        Margin="10"
                        Padding="10,6"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Background="#D9202935"
                        CornerRadius="3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Preview.HasImage}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock
                            Foreground="#FFF2F5F8"
                            Text="{Binding Preview.StatusText}"
                            TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock FontWeight="SemiBold" Text="Captured" />
                    <TextBlock Text="{Binding Preview.CapturedAtText}" TextWrapping="Wrap" />
                    <TextBlock Foreground="#FF8B97A6" Text="{Binding Preview.FrameAgeText}" />

                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Frame" />
                    <TextBlock Text="{Binding Preview.DimensionsText}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock FontWeight="SemiBold" Text="Exposure" />
                    <TextBlock Text="{Binding Preview.ExposureText}" />

                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Gain" />
                    <TextBlock Text="{Binding Preview.GainText}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock FontWeight="SemiBold" Text="Light mode" />
                    <TextBlock Text="{Binding Preview.ModeText}" TextWrapping="Wrap" />

                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Preview frames skipped" />
                    <TextBlock Text="{Binding Preview.DroppedFramesText}" />
                </StackPanel>
            </Grid>
        </Grid>
    </DataTemplate>

    <GeometryGroup x:Key="AutoPierCam_PierCameraSVG">
        <RectangleGeometry Rect="2,8,28,20" RadiusX="3" RadiusY="3" />
        <RectangleGeometry Rect="8,4,9,5" RadiusX="1" RadiusY="1" />
        <EllipseGeometry Center="16,18" RadiusX="7" RadiusY="7" />
        <EllipseGeometry Center="16,18" RadiusX="3" RadiusY="3" />
    </GeometryGroup>
</ResourceDictionary>
