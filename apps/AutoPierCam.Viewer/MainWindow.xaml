<Window
    x:Class="AutoPierCam.Viewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="24,18"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="AutoPierCam" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="12"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Glyph="&#xE783;" />
                    <TextBlock
                        x:Name="StatusText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Waiting for the local capture agent" />
                </StackPanel>
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Click="RefreshButton_Click"
                    Content="Refresh" />
                <Button
                    Click="CaptureButton_Click"
                    Content="Capture now"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="24" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="480" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Background="#FF101318"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="42"
                                Foreground="#FF718096"
                                Glyph="&#xE722;" />
                            <TextBlock
                                Foreground="#FFCBD5E1"
                                Text="Live preview will appear here" />
                            <TextBlock
                                FontSize="12"
                                Foreground="#FF718096"
                                Text="Latest-only JPEG stream · no camera access in the UI" />
                        </StackPanel>
                        <Border
                            Margin="12"
                            Padding="10,6"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#CC1E293B"
                            CornerRadius="4">
                            <TextBlock
                                FontSize="12"
                                Foreground="White"
                                Text="OFFLINE" />
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="14" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="3">
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Exposure" />
                            <TextBlock FontSize="17" Text="—" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Padding="14" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="3">
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Gain" />
                            <TextBlock FontSize="17" Text="—" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="14" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="3">
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Temperature" />
                            <TextBlock FontSize="17" Text="—" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Padding="14" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="3">
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Mode" />
                            <TextBlock FontSize="17" Text="—" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Capture settings" />
                    <StackPanel Spacing="6">
                        <TextBlock Text="Camera" />
                        <ComboBox IsEnabled="False" PlaceholderText="Agent not connected" />
                    </StackPanel>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Max exposure" />
                            <NumberBox Header="Milliseconds" Maximum="60000" Minimum="1" SpinButtonPlacementMode="Compact" Value="5000" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Max gain" />
                            <NumberBox Maximum="600" Minimum="0" SpinButtonPlacementMode="Compact" Value="300" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Still interval" />
                        <NumberBox Header="Seconds" Maximum="86400" Minimum="1" SpinButtonPlacementMode="Compact" Value="10" />
                    </StackPanel>
                    <ToggleSwitch Header="HTTP upload" OffContent="Disabled" OnContent="Enabled" />
                    <TextBox Header="Upload endpoint" PlaceholderText="https://example.test/camera/latest" />
                    <ToggleSwitch Header="Security video" OffContent="Disabled" OnContent="Enabled" />
                    <InfoBar
                        IsClosable="False"
                        IsOpen="True"
                        Message="Settings are read-only until the versioned named-pipe agent API lands."
                        Severity="Informational" />
                    <Button
                        HorizontalAlignment="Stretch"
                        Click="SaveButton_Click"
                        Content="Save settings"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid
            Grid.Row="2"
            Padding="24,12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Rust agent: disconnected" />
            <TextBlock Grid.Column="1" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Protocol v1" />
        </Grid>
    </Grid>
</Window>

