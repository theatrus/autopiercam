<Window
    x:Class="AutoPierCam.Viewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Padding="24,18"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="AutoPierCam" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        x:Name="StatusWarningIcon"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="12"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Glyph="&#xE783;"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="StatusText"
                        Grid.Column="1"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Waiting for the local capture agent" />
                </Grid>
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="SharingButton"
                    Click="SharingButton_Click"
                    Content="Chatstronomy" />
                <Button
                    x:Name="RefreshButton"
                    Click="RefreshButton_Click"
                    Content="Refresh" />
                <Button
                    x:Name="CaptureButton"
                    Click="CaptureButton_Click"
                    Content="Capture now"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="PauseButton" Content="Pause recording" IsEnabled="False" Click="PauseButton_Click" />
                <Button x:Name="SettingsButton" Content="Settings" Click="SettingsButton_Click" />
            </StackPanel>
        </Grid>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1" Padding="16,16,16,12" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="480" />
                <ColumnDefinition x:Name="SettingsColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="PreviewPane" RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Background="#FF101318"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Image
                            x:Name="PreviewImage"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Opacity="1"
                            Stretch="Uniform"
                            Visibility="Collapsed" />
                        <StackPanel
                            x:Name="PreviewPlaceholder"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="42"
                                Foreground="#FF718096"
                                Glyph="&#xE722;" />
                            <TextBlock
                                Foreground="#FFCBD5E1"
                                Text="Live preview will appear here" />
                            <TextBlock
                                FontSize="12"
                                Foreground="#FF718096"
                                Text="Frames appear as each exposure completes" />
                        </StackPanel>
                        <Border
                            Margin="12"
                            Padding="10,6"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#CC1E293B"
                            CornerRadius="4">
                            <TextBlock
                                x:Name="PreviewStatusText"
                                FontSize="12"
                                Foreground="White"
                                Text="CONNECTING" />
                        </Border>
                        <Button Content="Details" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                                AutomationProperties.Name="Preview details and resolution">
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel Width="380" Spacing="12">
                                        <TextBlock Text="Preview details" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock x:Name="PreviewDiagnosticsText" Text="Waiting for preview stream" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="The preview is reduced to a 1920-pixel long edge (full HD for 16:9 cameras). Saved stills use the capture dimensions (full sensor by default), not the preview size. Security video uses the preview resolution."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Border
                            Margin="12"
                            Padding="10,6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="#CC1E293B"
                            CornerRadius="4">
                            <TextBlock
                                x:Name="PreviewDetailText"
                                FontSize="12"
                                Foreground="White"
                                MaxWidth="490"
                                Text="Waiting for preview stream"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </Border>
                    </Grid>
                </Border>

                <TextBlock
                    x:Name="CaptureSummaryText"
                    Grid.Row="1"
                    Margin="0,6,0,0"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="NoWrap"
                    TextTrimming="CharacterEllipsis"
                    Visibility="Collapsed" />
            </Grid>

            <Grid x:Name="SettingsPane" Grid.Column="1" RowSpacing="12" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Capture settings" />
                    <StackPanel Spacing="6">
                        <TextBlock Text="Camera" />
                        <ComboBox
                            x:Name="CameraComboBox"
                            DisplayMemberPath="Label"
                            IsEnabled="False"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="CameraComboBox_SelectionChanged"
                            PlaceholderText="Agent not connected" />
                        <Button x:Name="RefreshCamerasButton" Content="Refresh cameras" IsEnabled="False" Click="RefreshCamerasButton_Click" />
                        <TextBlock x:Name="CameraHelpText" FontSize="12" TextWrapping="Wrap" Text="Connect to the agent to choose a camera." />
                    </StackPanel>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <Expander Header="Agent activity and storage" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12">
                    <Border Padding="12" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Agent activity" />
                            <TextBlock
                                x:Name="FrameCountsText"
                                Text="No status available" />
                            <TextBlock
                                x:Name="ExposureProgressText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Waiting for camera exposure status"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="LastArtifactText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Last artifact: none"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                            <TextBlock
                                x:Name="AgentLastErrorText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <Border Padding="12" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="4">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Upload activity" />
                                <Button
                                    x:Name="ManageOutboxButton"
                                    Grid.Column="1"
                                    Padding="8,3"
                                    Click="ManageOutboxButton_Click"
                                    Content="Manage outbox"
                                    FontSize="12"
                                    Visibility="Collapsed" />
                            </Grid>
                            <TextBlock
                                x:Name="OutboxAvailabilityText"
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Text="Outbox management is unavailable because the upload service is not running."
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="UploadActivityStateText"
                                Text="Unavailable" />
                            <TextBlock
                                x:Name="UploadActivityCountsText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="No upload telemetry loaded"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="UploadActivityTotalsText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="UploadLastSuccessText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="UploadLastFailureText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="StorageStatusCard"
                        Padding="12"
                        Style="{StaticResource CardBorderStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Storage retention" />
                            <TextBlock
                                x:Name="StoragePressureText"
                                Text="Unavailable" />
                            <TextBlock
                                x:Name="StorageBytesText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="StorageFreeText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="StorageSweepText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="StorageErrorText"
                                FontSize="12"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    </StackPanel>
                    </Expander>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Max exposure" />
                            <NumberBox
                                x:Name="MaxExposureNumberBox"
                                Header="Milliseconds"
                                IsEnabled="False"
                                Maximum="60000"
                                Minimum="0.001"
                                SpinButtonPlacementMode="Compact"
                                Value="60000" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Max gain" />
                            <NumberBox
                                x:Name="MaxGainNumberBox"
                                IsEnabled="False"
                                Maximum="600"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact"
                                Value="300" />
                        </StackPanel>
                    </Grid>
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="30,000 ms = 30 seconds · 60,000 ms = 1 minute. Automatic exposure adapts within the camera's supported limit."
                        TextWrapping="Wrap" />
                    <CheckBox x:Name="AdaptiveExposureCheckBox" Content="Application-controlled day/night exposure"
                              IsEnabled="False" Checked="ExposureControl_Changed" Unchecked="ExposureControl_Changed" />
                    <CheckBox x:Name="Raw16CheckBox" Content="RAW16 capture · lossless 16-bit PNG stills" IsEnabled="False" />
                    <TextBlock Text="Application control can exceed the SDK's 60-second auto limit, within the camera's manual range. RAW16 uses more storage."
                               FontSize="12" TextWrapping="Wrap" />
                    <TextBox x:Name="CameraNameFilterTextBox" Header="Camera model filter (optional)" PlaceholderText="ASI676MC"
                             IsEnabled="False" />
                    <StackPanel Spacing="6">
                        <TextBlock Text="Still interval" />
                        <NumberBox
                            x:Name="StillIntervalNumberBox"
                            Header="Seconds"
                            IsEnabled="False"
                            Maximum="86400"
                            Minimum="0.001"
                            SpinButtonPlacementMode="Compact"
                            Value="10" />
                    </StackPanel>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Managed image limit" />
                            <NumberBox
                                x:Name="RetentionMaxMiBNumberBox"
                                Header="MiB · blank disables"
                                IsEnabled="False"
                                Maximum="8796093022208"
                                Minimum="1"
                                PlaceholderText="Disabled"
                                SmallChange="128"
                                SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="Minimum disk free" />
                            <NumberBox
                                x:Name="RetentionMinFreeMiBNumberBox"
                                Header="MiB · blank disables"
                                IsEnabled="False"
                                Maximum="8796093022208"
                                Minimum="1"
                                PlaceholderText="Disabled"
                                SmallChange="128"
                                SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                    </Grid>
                    <TextBlock
                        x:Name="RetentionSettingsAvailabilityText"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Retention limits are read-only because this agent does not advertise retention management."
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <ToggleSwitch
                        x:Name="UploadEnabledToggle"
                        Header="HTTP upload"
                        IsEnabled="False"
                        OffContent="Disabled"
                        OnContent="Enabled" />
                    <TextBox
                        x:Name="UploadEndpointTextBox"
                        Header="Upload endpoint"
                        IsEnabled="False"
                        PlaceholderText="https://example.test/camera/latest" />
                    <ToggleSwitch
                        x:Name="VideoEnabledToggle"
                        Header="Security video"
                        IsEnabled="False"
                        OffContent="Disabled"
                        OnContent="Enabled" />
                    <TextBox x:Name="FfmpegPathTextBox" Header="FFmpeg executable (installed separately)"
                             PlaceholderText="C:\Tools\ffmpeg\bin\ffmpeg.exe" IsEnabled="False" />
                    <TextBlock Text="Security recording saves H.264 MP4 segments from previews (up to 2 fps). Long exposures produce fewer frames. Pause and storage limits also pause video sampling."
                               TextWrapping="Wrap" />
                </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Spacing="8">
                    <InfoBar
                        x:Name="ConfigInfoBar"
                        IsClosable="False"
                        IsOpen="False"
                        IsIconVisible="False"
                        Message="Connect to the local agent to load settings."
                        Severity="Informational" />
                    <Button
                        x:Name="SaveButton"
                        HorizontalAlignment="Stretch"
                        Click="SaveButton_Click"
                        Content="Save settings"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
