<Window
    x:Class="AutoPierCam.Viewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="HeaderBar"
            Grid.Row="0"
            Padding="16,6"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid ColumnSpacing="10" Margin="0,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image x:Name="BrandLogo" Source="ms-appx:///Assets/autopiercam.png"
                       Width="32" Height="32" Stretch="Uniform" VerticalAlignment="Center"
                       AutomationProperties.Name="AutoPierCam logo" />
                <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="BrandNameText"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="AutoPierCam" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            x:Name="StatusWarningIcon"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Glyph="&#xE783;"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="StatusText"
                            FontSize="12"
                            Grid.Column="1"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{Binding Text, ElementName=StatusText}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Connecting…" />
                    </Grid>
                </StackPanel>
            </Grid>
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="CaptureButton"
                    Click="CaptureButton_Click"
                    Content="Save next frame"
                    ToolTipService.ToolTip="Save the next completed frame to disk."
                    Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="PauseButton" Content="Pause recording" IsEnabled="False" Click="PauseButton_Click" />
                <Button x:Name="SettingsButton" Content="Settings" Click="SettingsButton_Click" />
            </StackPanel>
        </Grid>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1" Padding="16,16,16,12" ColumnSpacing="0" SizeChanged="WorkspaceGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PreviewColumn" Width="*" />
                <ColumnDefinition x:Name="SettingsColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="PreviewPane" RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Background="#FF101318"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Image
                            x:Name="PreviewImage"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Opacity="1"
                            Stretch="Uniform"
                            Visibility="Collapsed" />
                        <StackPanel
                            x:Name="PreviewPlaceholder"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="42"
                                Foreground="#FF718096"
                                Glyph="&#xE722;" />
                            <TextBlock
                                Foreground="#FFCBD5E1"
                                Text="Waiting for a frame" />
                            <TextBlock
                                FontSize="12"
                                Foreground="#FF718096"
                                Text="Updates after each exposure" />
                        </StackPanel>
                        <Border
                            Margin="12"
                            Padding="10,6"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#CC1E293B"
                            CornerRadius="4">
                            <TextBlock
                                x:Name="PreviewStatusText"
                                FontSize="12"
                                Foreground="White"
                                Text="CONNECTING" />
                        </Border>
                        <Button Content="Details" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                                AutomationProperties.Name="Preview details and resolution">
                            <Button.Flyout>
                                <Flyout x:Name="PreviewDetailsFlyout">
                                    <StackPanel Width="380" Spacing="12">
                                        <TextBlock Text="Preview details" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock x:Name="PreviewDiagnosticsText" Text="Waiting for preview stream" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <Button x:Name="SkyModelSettingsButton" Content="Experimental sky model…" Click="SkyModelSettings_Click" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Border
                            Margin="12"
                            Padding="10,6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="#CC1E293B"
                            CornerRadius="4">
                            <TextBlock
                                x:Name="PreviewDetailText"
                                FontSize="12"
                                Foreground="White"
                                MaxWidth="490"
                                Text="Waiting for preview stream"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="CaptureSummaryText"
                        Margin="0,6,0,0"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis"
                        Visibility="Collapsed" />
                    <TextBlock x:Name="SkyEstimateText" Grid.Column="1" MaxWidth="300" Margin="0,6,0,0" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                </Grid>
            </Grid>

            <Grid x:Name="SettingsPane" Grid.Column="1" RowSpacing="8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <SelectorBar x:Name="SettingsSectionBar" SelectionChanged="SettingsSectionBar_SelectionChanged">
                        <SelectorBarItem x:Name="CaptureSectionItem" Text="Capture" IsSelected="True" />
                        <SelectorBarItem x:Name="SharingSectionItem" Text="Chatstronomy" />
                    </SelectorBar>
                </StackPanel>

                <!-- Both sections share one layout: Reload at the top, scrolling
                     fields, and a fixed footer with feedback, Discard and Save. -->
                <Grid x:Name="CaptureSection" Grid.Row="1" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="8">
                        <Button x:Name="RefreshButton" Click="RefreshButton_Click" Content="Reload settings"
                                ToolTipService.ToolTip="Reload saved settings and the cached camera list." />
                    </StackPanel>
                    <ScrollViewer x:Name="CaptureSettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                                  HorizontalContentAlignment="Stretch" Padding="0,4,20,12">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <ComboBox x:Name="CameraDriverComboBox" Header="Camera driver" HorizontalAlignment="Stretch" IsEnabled="False">
                                <ComboBoxItem Content="Regain · ZWO SDK" Tag="zwo_sdk" />
                                <ComboBoxItem Content="Regain · ZWO Direct USB (experimental)" Tag="zwo_direct" />
                            </ComboBox>
                            <TextBox x:Name="CameraSerialTextBox" Header="Camera serial (optional for one matching camera)" PlaceholderText="Verified after connection; optionally enter the expected serial" IsEnabled="False" />
                            <TextBlock Text="ASI662MC and ASI676MC support Direct USB: RAW16, bin 1, up to 2,000 s. Changing drivers restarts capture."
                                       FontSize="12" TextWrapping="Wrap" />
                            <TextBlock Text="Camera" />
                            <ComboBox
                                x:Name="CameraComboBox"
                                DisplayMemberPath="Label"
                                IsEnabled="False"
                                HorizontalAlignment="Stretch"
                                SelectionChanged="CameraComboBox_SelectionChanged"
                                PlaceholderText="Agent not connected" />
                            <Button x:Name="RefreshCamerasButton" Content="Reload camera list" IsEnabled="False" Click="RefreshCamerasButton_Click" />
                            <Button Content="Camera discovery details">
                                <Button.Flyout>
                                    <Flyout>
                                        <TextBlock x:Name="CameraHelpText" MaxWidth="340" FontSize="12" TextWrapping="Wrap"
                                                   Text="Connect to the agent to choose a camera." />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <Expander Header="Agent activity and storage" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12">
                        <Border Padding="12" Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Agent activity" />
                                <TextBlock
                                    x:Name="FrameCountsText"
                                    Text="No status available" />
                                <TextBlock
                                    x:Name="ExposureProgressText"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Waiting for camera exposure status"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="LastArtifactText"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Last artifact: none"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock
                                    x:Name="AgentLastErrorText"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <Border Padding="12" Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="4">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Upload activity" />
                                    <Button
                                        x:Name="ManageOutboxButton"
                                        Grid.Column="1"
                                        Padding="8,3"
                                        Click="ManageOutboxButton_Click"
                                        Content="Manage outbox"
                                        FontSize="12"
                                        Visibility="Collapsed" />
                                </Grid>
                                <TextBlock
                                    x:Name="OutboxAvailabilityText"
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Text="Upload service is stopped."
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    x:Name="UploadActivityStateText"
                                    Text="Unavailable" />
                                <TextBlock
                                    x:Name="UploadActivityCountsText"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="No upload telemetry loaded"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="UploadActivityTotalsText"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    x:Name="UploadLastSuccessText"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    x:Name="UploadLastFailureText"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <Border
                            x:Name="StorageStatusCard"
                            Padding="12"
                            Style="{StaticResource CardBorderStyle}"
                            Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Storage retention" />
                                <TextBlock
                                    x:Name="StoragePressureText"
                                    Text="Unavailable" />
                                <TextBlock
                                    x:Name="StorageBytesText"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="StorageFreeText"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="StorageSweepText"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="StorageErrorText"
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        </StackPanel>
                        </Expander>
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Max exposure" />
                                <NumberBox
                                    x:Name="MaxExposureNumberBox"
                                    Header="Milliseconds"
                                    IsEnabled="False"
                                    Maximum="60000"
                                    Minimum="0.001"
                                    SpinButtonPlacementMode="Compact"
                                    Value="60000" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Max gain" />
                                <NumberBox
                                    x:Name="MaxGainNumberBox"
                                    IsEnabled="False"
                                    Maximum="600"
                                    Minimum="0"
                                    SpinButtonPlacementMode="Compact"
                                    Value="300" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="30,000 ms = 30 s · 60,000 ms = 1 min"
                            TextWrapping="Wrap" />
                        <ToggleSwitch x:Name="AdaptiveExposureToggle" Header="Application-controlled day/night exposure"
                                      IsEnabled="False" IsOn="True" Visibility="Collapsed" Toggled="ExposureControl_Changed" />
                        <TextBlock Text="AutoPierCam controls exposure and gain through Regain." FontSize="12" TextWrapping="Wrap" />
                        <ToggleSwitch x:Name="UsbResetOnFaultToggle" Header="Reset this camera's USB port after capture failure"
                                      IsEnabled="False" IsOn="False" />
                        <TextBlock Text="Opt-in Windows recovery. Requires a saved camera serial and an administrator-started agent. Resets only the verified camera port after closing capture, at most once every 5 minutes. Never resets a hub or prompts for elevation. Other faults use normal retry. USB reset may not remove physical power."
                                   FontSize="12" TextWrapping="Wrap" />
                        <NumberBox x:Name="LatitudeNumberBox" Header="Observing latitude · degrees north"
                                   Minimum="-90" Maximum="90" IsEnabled="False" />
                        <NumberBox x:Name="LongitudeNumberBox" Header="Observing longitude · degrees east"
                                   Minimum="-180" Maximum="180" IsEnabled="False" />
                        <TextBlock Text="Set both coordinates to choose day/night at capture startup. West and south are negative. Leave both blank to use exposure feedback only. Changes take effect on next capture start."
                                   FontSize="12" TextWrapping="Wrap" />
                        <StackPanel Spacing="8">
                            <NumberBox x:Name="MinGainNumberBox" Header="Minimum gain · application control only"
                                       Minimum="0" Maximum="600" Value="0" SmallChange="10"
                                       SpinButtonPlacementMode="Compact" IsEnabled="False" />
                            <ToggleSwitch x:Name="PreferShortExposuresToggle" Header="Prefer shorter exposures"
                                          IsEnabled="False" />
                            <TextBlock x:Name="GainControlHelpText" FontSize="12" TextWrapping="Wrap"
                                       Text="Minimum gain requires application control." />
                            <TextBlock FontSize="12" TextWrapping="Wrap"
                                       Text="Equal gain limits hold gain fixed. Shorter exposures raises gain first, increasing noise." />
                        </StackPanel>
                        <ToggleSwitch x:Name="Raw16Toggle" Header="Save lossless 16-bit PNG stills" IsEnabled="False" />
                        <ComboBox x:Name="WhiteBalanceModeComboBox" Header="Color white balance · Regain"
                                  HorizontalAlignment="Stretch" SelectedIndex="0" IsEnabled="False">
                            <ComboBoxItem Content="Disabled · preserve backend defaults" />
                            <ComboBoxItem Content="Manual" />
                            <ComboBoxItem Content="Auto once per capture session" />
                            <ComboBoxItem Content="Auto continuous" />
                        </ComboBox>
                        <NumberBox x:Name="WhiteBalanceRedNumberBox" Header="Red multiplier / initial AWB gain"
                                   Minimum="0.125" Maximum="8" Value="1" SmallChange="0.1" IsEnabled="False" />
                        <NumberBox x:Name="WhiteBalanceBlueNumberBox" Header="Blue multiplier / initial AWB gain"
                                   Minimum="0.125" Maximum="8" Value="1" SmallChange="0.1" IsEnabled="False" />
                        <TextBlock Text="Linear multipliers relative to green (1), not SDK slider values. Regain applies WB to previews and saved images, including 16-bit PNGs. Save restarts capture; Auto once estimates again after reconnect. For stars or narrowband scenes, prefer Manual: AWB assumes a neutral scene."
                                   FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="16-bit PNGs use more storage than JPEGs. Exposure limits depend on the selected driver."
                                   FontSize="12" TextWrapping="Wrap" />
                        <TextBox x:Name="CameraNameFilterTextBox" Header="Camera model filter (optional)" PlaceholderText="ASI676MC"
                                 IsEnabled="False" />
                        <StackPanel Spacing="6">
                            <TextBlock Text="Maximum preview frame rate" />
                            <NumberBox x:Name="PreviewMaxFpsNumberBox" Header="Frames per second"
                                       Minimum="0.01" Maximum="30" SmallChange="0.1" LargeChange="1"
                                       SpinButtonPlacementMode="Compact" Value="2" IsEnabled="False" />
                            <TextBlock Text="Default: 2 fps. Decimal rates are supported: 0.5 = every 2 seconds; 0.1 = every 10 seconds. Exposure time may limit the actual rate. Older agents require whole numbers from 1 to 30."
                                       FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Still interval" />
                            <NumberBox
                                x:Name="StillIntervalNumberBox"
                                Header="Seconds"
                                IsEnabled="False"
                                Maximum="86400"
                                Minimum="0.001"
                                SpinButtonPlacementMode="Compact"
                                Value="10" />
                        </StackPanel>
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Managed image limit" />
                                <NumberBox
                                    x:Name="RetentionMaxMiBNumberBox"
                                    Header="MiB · blank disables"
                                    IsEnabled="False"
                                    Maximum="8796093022208"
                                    Minimum="1"
                                    PlaceholderText="Disabled"
                                    SmallChange="128"
                                    SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Minimum disk free" />
                                <NumberBox
                                    x:Name="RetentionMinFreeMiBNumberBox"
                                    Header="MiB · blank disables"
                                    IsEnabled="False"
                                    Maximum="8796093022208"
                                    Minimum="1"
                                    PlaceholderText="Disabled"
                                    SmallChange="128"
                                    SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock
                            x:Name="RetentionSettingsAvailabilityText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Update the agent to edit storage limits."
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                        <ToggleSwitch
                            x:Name="UploadEnabledToggle"
                            Header="HTTP upload"
                            IsEnabled="False"
                            OffContent="Disabled"
                            OnContent="Enabled" />
                        <TextBox
                            x:Name="UploadEndpointTextBox"
                            Header="Upload endpoint"
                            IsEnabled="False"
                            PlaceholderText="https://example.test/camera/latest" />
                        <ToggleSwitch
                            x:Name="VideoEnabledToggle"
                            Header="Security video"
                            IsEnabled="False"
                            OffContent="Disabled"
                            OnContent="Enabled" />
                        <TextBox x:Name="FfmpegPathTextBox" Header="FFmpeg executable (installed separately)"
                                 PlaceholderText="C:\Tools\ffmpeg\bin\ffmpeg.exe" IsEnabled="False" />
                        <TextBlock Text="Records H.264 MP4 at preview resolution. Pauses with recording or storage limits."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Spacing="8">
                        <InfoBar
                            x:Name="ConfigInfoBar"
                            IsClosable="False"
                            IsOpen="False"
                            IsIconVisible="False"
                            Message="Connect to the local agent to load settings."
                            Severity="Informational">
                            <InfoBar.ActionButton>
                                <Button x:Name="CaptureKeepEditsButton" Content="Keep my edits"
                                        Click="CaptureKeepEditsButton_Click" Visibility="Collapsed" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="CaptureDiscardButton"
                                HorizontalAlignment="Stretch"
                                Click="CaptureDiscardButton_Click"
                                Content="Discard changes"
                                IsEnabled="False" />
                            <Button
                                x:Name="SaveButton"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Click="SaveButton_Click"
                                Content="Save settings"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid x:Name="SharingSection" Grid.Row="1" RowSpacing="12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="8">
                        <Button x:Name="SharingReloadButton" Click="SharingReloadButton_Click" Content="Reload settings"
                                ToolTipService.ToolTip="Reload saved sharing settings." />
                        <TextBlock x:Name="SharingConnectionText" TextWrapping="Wrap" Text="Not loaded" />
                    </StackPanel>
                    <ScrollViewer x:Name="SharingSettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                                  HorizontalContentAlignment="Stretch" Padding="0,4,20,12">
                        <StackPanel x:Name="SharingFields" Spacing="16">
                            <StackPanel x:Name="SharingPairingGroup" Spacing="10">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Pair with your Hub" />
                                <TextBlock TextWrapping="Wrap"
                                           Text="Hub → Observatory devices → Add pier camera. Select a server and channels, then choose Pair camera." />
                                <TextBox x:Name="SharingOriginTextBox" Header="Hub HTTPS origin" PlaceholderText="https://your-chatstronomy-hub" />
                                <PasswordBox x:Name="SharingCodePasswordBox" Header="One-use device pairing code" PlaceholderText="Paste code from the Hub" />
                                <Button x:Name="SharingPairButton" Click="SharingPairButton_Click" Content="Pair camera" />
                                <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Pairing keeps settings and does not enable sharing." />
                            </StackPanel>
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Choose what to share" />
                                <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Sends previews to your Hub channels. Snapshot now uses the latest frame, up to 2 min old." />
                                <ToggleSwitch x:Name="SharingEnabledToggle" Header="Enable image sharing" />
                                <Button x:Name="SharingStopButton" Click="SharingStopButton_Click" Content="Stop sharing now"
                                        ToolTipService.ToolTip="Stop sharing now. Keep unsaved edits." />
                                <ToggleSwitch x:Name="SharingSnapshotsToggle" Header="Allow Snapshot now requests" />
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Send an image every" />
                                    <NumberBox x:Name="SharingIntervalNumberBox" Header="Minutes · 0 = off"
                                               Minimum="0" Maximum="1440" SmallChange="1" SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                                <Expander Header="Scene and telescope events" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="10">
                                        <ToggleSwitch x:Name="SharingScenesToggle" Header="Send when the scene changes" />
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Changed area threshold" />
                                            <NumberBox x:Name="SharingThresholdNumberBox" Header="Percent · 5–80"
                                                       Minimum="5" Maximum="80" SmallChange="1" SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="SharingDayNightToggle" Header="Send on day / night transitions" />
                                        <ToggleSwitch x:Name="SharingTelescopeToggle" Header="Send on slew / sequence events" />
                                        <StackPanel Spacing="12">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Images per event" />
                                                <NumberBox x:Name="SharingBurstNumberBox" Header="1–3"
                                                           Minimum="1" Maximum="3" SmallChange="1" SpinButtonPlacementMode="Compact" />
                                            </StackPanel>
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Time between images" />
                                                <NumberBox x:Name="SharingSpacingNumberBox" Header="Seconds · 60–600"
                                                           Minimum="60" Maximum="600" SmallChange="10" SpinButtonPlacementMode="Compact" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="Telescope events need the same owner and a shared Hub channel. The Hub posts at most one image per minute." />
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Chat control" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="10">
                                        <ToggleSwitch x:Name="SharingChatToggle" Header="Allow the camera owner to adjust triggers in chat" />
                                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="Chat can disable triggers or reduce sending. It cannot exceed these limits. Saving clears chat overrides." />
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Connection details / change Hub" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="10">
                                        <TextBlock x:Name="SharingDetailsText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="Forget pairing to change Hub. This clears permissions. Also revoke the device in the Hub." />
                                        <CheckBox x:Name="SharingForgetConsentCheckBox" Content="Remove pairing and clear sharing permissions"
                                                  Checked="SharingForgetConsent_Changed" Unchecked="SharingForgetConsent_Changed" />
                                        <Button x:Name="SharingForgetButton" Click="SharingForgetButton_Click" Content="Forget pairing" />
                                    </StackPanel>
                                </Expander>
                                <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Stopping clears queued images, not posted messages. Retries may duplicate posts." />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Spacing="8">
                        <InfoBar
                            x:Name="SharingInfoBar"
                            IsClosable="False"
                            IsOpen="False"
                            IsIconVisible="False"
                            Severity="Informational">
                            <InfoBar.ActionButton>
                                <Button x:Name="SharingKeepEditsButton" Content="Keep my edits"
                                        Click="SharingKeepEditsButton_Click" Visibility="Collapsed" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="SharingDiscardButton"
                                HorizontalAlignment="Stretch"
                                Click="SharingDiscardButton_Click"
                                Content="Discard changes"
                                IsEnabled="False" />
                            <Button
                                x:Name="SharingSaveButton"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Click="SharingSaveButton_Click"
                                Content="Save settings"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
